VITE_DEFAULT_CACHE_MAX_ENTRIES=1000000
VITE_SUMMARIZE_MAX_CHARS=60000
VITE_SUMMARY_CACHE_MAX_ENTRIES=2000
VITE_DEFAULT_SUMMARY_FONT_PX=16
VITE_OPENCC_T2S_FROM=twp
VITE_OPENCC_T2S_TO=cn
VITE_OPENCC_S2T_FROM=cn
VITE_OPENCC_S2T_TO=twp
