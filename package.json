{
  "name": "nutation",
  "description": "Nutation — translate pages with OpenAI, Anthropic, Gemini, DeepSeek, xAI, Mistral, OpenRouter, or Vercel AI Gateway.",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "release": "node scripts/package-extensions.mjs",
    "release:all": "node scripts/package-extensions.mjs all",
    "release:chrome": "node scripts/package-extensions.mjs chrome",
    "release:edge": "node scripts/package-extensions.mjs edge",
    "release:firefox": "node scripts/package-extensions.mjs firefox",
    "release:safari": "node scripts/package-extensions.mjs safari",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.48.0",
    "opencc-js": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.27"
  }
}
